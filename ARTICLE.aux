\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Training: jam-weighted Huber + load-balanced gate}{7}{subsection.3.4}\protected@file@percent }
\newlabel{sec:model-training}{{3.4}{7}{Training: jam-weighted Huber + load-balanced gate}{subsection.3.4}{}}
\newlabel{eq:loss-imp}{{6}{7}{Training: jam-weighted Huber + load-balanced gate}{equation.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textsc  {Marst}\xspace  architecture. Three causal anchors are computed on the left ($a_{\textsc  {locf}\xspace  }$ with per-sensor learnable EMA decay $d_n = \sigma (\ell _n)$, $a_{\textsc  {ha}\xspace  }$ from the training-window seasonal lookup, $a_{\textsc  {knn}\xspace  }$ from the adjacency-weighted observed-neighbour mean) and stacked with the masked value, the binary mask, the time-of-day encoding, the staleness counter, and the 2-hop neighbour-mean into a 9-channel feature. A linear projection $\mathbb  {R}^{9} \to \mathbb  {R}^{128}$ is augmented with per-sensor identity and sinusoidal time-of-day position embeddings and passed through six STBlock layers, each alternating a causal-masked temporal self-attention sub-layer with a mask-aware spatial self-attention sub-layer. Three heads finish the model: the \emph  {anchor gate} emits $\bm  {\pi }\in \Delta ^{2}$, the \emph  {residual head} emits $r$, and the \emph  {meta-gate} emits the scalar mixing weight $\alpha \in (0, 1)$. The final prediction is given by Equation~\ref {eq:marst-prediction}.}}{8}{figure.caption.3}\protected@file@percent }
\newlabel{fig:architecture}{{2}{8}{\MARST architecture. Three causal anchors are computed on the left ($a_{\LOCF }$ with per-sensor learnable EMA decay $d_n = \sigma (\ell _n)$, $a_{\HA }$ from the training-window seasonal lookup, $a_{\KNN }$ from the adjacency-weighted observed-neighbour mean) and stacked with the masked value, the binary mask, the time-of-day encoding, the staleness counter, and the 2-hop neighbour-mean into a 9-channel feature. A linear projection $\Real ^{9} \to \Real ^{128}$ is augmented with per-sensor identity and sinusoidal time-of-day position embeddings and passed through six STBlock layers, each alternating a causal-masked temporal self-attention sub-layer with a mask-aware spatial self-attention sub-layer. Three heads finish the model: the \emph {anchor gate} emits $\gatevec \in \Delta ^{2}$, the \emph {residual head} emits $r$, and the \emph {meta-gate} emits the scalar mixing weight $\alpha \in (0, 1)$. The final prediction is given by Equation~\ref {eq:marst-prediction}}{figure.caption.3}{}}
\newlabel{eq:loss-lb}{{7}{8}{Training: jam-weighted Huber + load-balanced gate}{equation.7}{}}
