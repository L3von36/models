\@writefile{toc}{\contentsline {paragraph}{The headline win is real, load-bearing, and deployable.}{21}{section.6}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The load-balancing aux loss is doing work --- and the absence of expert collapse is itself a finding.}{21}{section.6}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Per-sensor learnable decay was a negative finding.}{22}{section.6}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The KNN anchor is interesting as a backstop.}{22}{section.6}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Curriculum is small but free.}{22}{section.6}\protected@file@percent }
