        <!-- ===== LEFT COLUMN: 3 CAUSAL ANCHORS ===== -->

        <!-- a_LOCF  x=30 y=82 w=235 h=108 -->
        <mxCell id="A1" value="&lt;b style=&quot;color:#1E40AF;font-size:12px;&quot;&gt;a&lt;sub&gt;LOCF&lt;/sub&gt; — Recency&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border:none;border-top:1px solid #BFDBFE;margin:4px 0;&quot;&gt;&lt;span style=&quot;color:#3730A3;font-size:10px;line-height:1.5;&quot;&gt;Hard LOCF: last observed value,&lt;br&gt;carried forward over blind cells.&lt;br&gt;HA-initialised at t=0.&lt;br&gt;Staleness tracked as input feat.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background:#DBEAFE;color:#1E40AF;font-size:8px;font-weight:bold;padding:1px 6px;border-radius:8px;&quot;&gt;CAUSAL CARRY&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;verticalAlign=top;spacingTop=5;spacingLeft=8;arcSize=10;" vertex="1" parent="1">
