          <mxGeometry x="30" y="204" width="235" height="90" as="geometry" />
        </mxCell>

        <!-- a_KNN  x=30 y=308 w=235 h=108 -->
        <mxCell id="A3" value="&lt;b style=&quot;color:#065F46;font-size:12px;&quot;&gt;a&lt;sub&gt;KNN&lt;/sub&gt; — Spatial&lt;/b&gt;&lt;br&gt;&lt;hr style=&quot;border:none;border-top:1px solid #A7F3D0;margin:4px 0;&quot;&gt;&lt;span style=&quot;color:#064E3B;font-size:10px;line-height:1.5;&quot;&gt;De-z-score → adj-weighted mean&lt;br&gt;of observed 1-hop nbrs →&lt;br&gt;re-z-score by target node.&lt;br&gt;Falls back to HA. Adj diag = 0.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background:#D1FAE5;color:#065F46;font-size:8px;font-weight:bold;padding:1px 6px;border-radius:8px;&quot;&gt;GRAPH-BASED&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;verticalAlign=top;spacingTop=5;spacingLeft=8;arcSize=10;" vertex="1" parent="1">
